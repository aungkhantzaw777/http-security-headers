{
    "name": "aungkhantzaw777/http-security-headers",
    "description": "Laravel security headers toolkit with reusable HTTP header enums.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "laravel",
        "http",
        "security",
        "headers",
        "enum"
    ],
    "homepage": "https://github.com/aungkhantzaw777/http-security-headers",
    "authors": [
        {
            "name": "Aung Khant Zaw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/http-foundation": "^7.2 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "AungKhant\\HttpSecurityHeaders\\": "src/"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "AungKhant\\HttpSecurityHeaders\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AungKhant\\HttpSecurityHeaders\\SecurityHeadersServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    }
}
